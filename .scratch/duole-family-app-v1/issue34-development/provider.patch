+def test_navigation_retains_safety_preemption_and_refuses_busy_replacement(tmp_path):
+    from duole_central.skills.navigation.domain import TaskPriority, TaskResource
+
+    service, executor, coordinator, request = setup(tmp_path)
+    assert service.execute(request)["status"] == "accepted"
+    active = coordinator.active_tasks()[0]
+    assert active.domain == "navigation" and active.interruptible
+    safety = coordinator.start_task(
+        task_id="fall_safety",
+        domain="vision_fall",
