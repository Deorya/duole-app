+"""Read fresh ROS safety observations and load revisioned keepout masks."""
+
+from datetime import datetime, timezone
+import json
+import math
+from pathlib import Path
+import tempfile
+import time
+
+from duole_central.app_gateway.map_catalog import MapCatalogError
+from duole_central.navigation_board.map_semantics import (
+    Grid,
+    SemanticObservation,
+    inside,
+    same_grid,
+)
+
+
+def grid_from_message(message):
+    info = message.info
+    origin = info.origin
+    q = origin.orientation
+    yaw = math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))
+    if (
+        message.header.frame_id != "map"
+        or info.width < 1
+        or info.height < 1
+        or info.width * info.height > 16777216
+        or info.resolution <= 0
+        or len(message.data) != info.width * info.height
+    ):
+        raise MapCatalogError("SEMANTIC_COSTMAP_UNTRUSTED")
+    return Grid(
+        info.width,
+        info.height,
+        float(info.resolution),
+        (float(origin.position.x), float(origin.position.y), yaw),
+        tuple(message.data),
+    )
+
+
+class RosSemanticRuntime:
+    def __init__(self, state_directory, map_root, *, module_loader=None):
+        import importlib
+
+        self.load = module_loader or importlib.import_module
+        self.state = Path(state_directory)
+        self.map_root = Path(map_root)
+
+    def _node(self):
+        rclpy = self.load("rclpy")
+        started = not rclpy.ok()
+        if started:
+            rclpy.init(args=None)
+        node = rclpy.create_node("duole_map_semantics")
+        executor = self.load("rclpy.executors").SingleThreadedExecutor()
+        executor.add_node(node)
+        return rclpy, node, executor, started
+
+    @staticmethod
+    def _close(rclpy, node, executor, started):
+        executor.remove_node(node)
+        executor.shutdown()
+        node.destroy_node()
+        if started:
+            rclpy.shutdown()
+
+    def observe(self, map_id, map_revision):
+        handle = None
+        try:
+            selected = json.loads((self.state / "active-map.json").read_text())
+            if (
+                selected["map_id"] != map_id
+                or selected.get("artifact_revision", selected["map_revision"])
+                != map_revision
+            ):
+                raise MapCatalogError(
+                    "MAP_REVISION_CONFLICT", current_revision=map_revision
+                )
+            handle = self._node()
+            rclpy, node, executor, _ = handle
+            grid_type = self.load("nav_msgs.msg").OccupancyGrid
+            pose_type = self.load("geometry_msgs.msg").PoseWithCovarianceStamped
+            qos = self.load("rclpy.qos")
+            retained = qos.QoSProfile(
+                depth=1,
+                reliability=qos.ReliabilityPolicy.RELIABLE,
+                durability=qos.DurabilityPolicy.TRANSIENT_LOCAL,
+            )
+            observed = {}
+
+            def record(name, message):
+                observed[name] = (message, time.monotonic())
+
+            node.create_subscription(
+                grid_type, "/map", lambda msg: record("map", msg), retained
+            )
+            node.create_subscription(
+                grid_type,
+                "/global_costmap/costmap",
+                lambda msg: record("costmap", msg),
+                retained,
+            )
+            node.create_subscription(
+                pose_type, "/amcl_pose", lambda msg: record("pose", msg), retained
+            )
+            deadline = time.monotonic() + 5
+            while time.monotonic() < deadline and len(observed) < 3:
+                executor.spin_once(timeout_sec=0.05)
+            if len(observed) != 3:
+                raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED")
+            now_ns = node.get_clock().now().nanoseconds
+            for name in ("costmap", "pose"):
+                message = observed[name][0]
+                stamp = message.header.stamp
+                age = (now_ns - stamp.sec * 1000000000 - stamp.nanosec) / 1000000000
+                if not 0 <= age <= 2:
+                    raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED")
+            pose = observed["pose"][0]
+            covariance = pose.pose.covariance
+            trusted = pose.header.frame_id == "map" and all(
+                math.isfinite(covariance[i]) and 0 <= covariance[i] <= 0.25
+                for i in (0, 7, 35)
+            )
+            p = pose.pose.pose.position
+            if not math.isfinite(p.x) or not math.isfinite(p.y):
+                trusted = False
+            return SemanticObservation(
+                map_id,
+                map_revision,
+                grid_from_message(observed["map"][0]),
+                grid_from_message(observed["costmap"][0]),
+                {"x_m": p.x, "y_m": p.y},
+                datetime.now(timezone.utc),
+                trusted,
+            )
+        except MapCatalogError:
+            raise
+        except Exception as exc:
+            raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED") from exc
+        finally:
+            if handle:
+                self._close(*handle)
+
+    def apply_keepouts(self, grid, zones):
+        # The files belong to this map configuration; no consumer chooses a path.
+        root = self.map_root / "semantic-masks"
+        root.mkdir(parents=True, exist_ok=True)
+        polygons = [z["polygon"] for z in zones]
+        pixels = bytearray()
+        for y in range(grid.height - 1, -1, -1):
+            for x in range(grid.width):
+                pixels.append(
+                    0 if any(inside(grid.point((x, y)), p) for p in polygons) else 254
+                )
+        handle = None
+        try:
+            with tempfile.TemporaryDirectory(dir=root, prefix="mask-") as directory:
+                pgm = Path(directory) / "mask.pgm"
+                yaml = Path(directory) / "mask.yaml"
+                pgm.write_bytes(
+                    f"P5\n{grid.width} {grid.height}\n255\n".encode() + pixels
+                )
+                yaml.write_text(
+                    f"image: mask.pgm\nmode: trinary\nresolution: {grid.resolution}\norigin: {list(grid.origin)}\nnegate: 0\noccupied_thresh: 0.65\nfree_thresh: 0.196\n"
+                )
+                handle = self._node()
+                rclpy, node, executor, _ = handle
+                fresh_costmap = []
+                since = node.get_clock().now().nanoseconds
+
+                def observe_costmap(message):
+                    stamp = message.header.stamp
+                    if stamp.sec * 1000000000 + stamp.nanosec >= since:
+                        fresh_costmap[:] = [grid_from_message(message)]
+
+                node.create_subscription(
+                    self.load("nav_msgs.msg").OccupancyGrid,
+                    "/global_costmap/costmap",
+                    observe_costmap,
+                    1,
+                )
+                srv = self.load("nav2_msgs.srv").LoadMap
+                client = node.create_client(srv, "/keepout_filter_mask_server/load_map")
+                if not client.wait_for_service(timeout_sec=2):
+                    raise MapCatalogError("KEEPOUT_RUNTIME_UNAVAILABLE")
+                request = srv.Request()
+                request.map_url = str(yaml)
+                future = client.call_async(request)
+                deadline = time.monotonic() + 5
+                while not future.done() and time.monotonic() < deadline:
+                    executor.spin_once(timeout_sec=0.05)
+                if (
+                    not future.done()
+                    or future.result() is None
+                    or future.result().result != 0
+                ):
+                    raise MapCatalogError("KEEPOUT_RUNTIME_UNAVAILABLE")
+                expected = Grid(
+                    grid.width,
+                    grid.height,
+                    grid.resolution,
+                    grid.origin,
+                    tuple(
+                        (
+                            100
+                            if any(inside(grid.point((x, y)), p) for p in polygons)
+                            else 0
+                        )
+                        for y in range(grid.height)
+                        for x in range(grid.width)
+                    ),
+                )
+                if not same_grid(grid_from_message(future.result().map), expected):
+                    raise MapCatalogError("KEEPOUT_RUNTIME_UNAVAILABLE")
+                deadline = time.monotonic() + 3
+                blocked = [
+                    grid.point((x, y))
+                    for y in range(grid.height)
+                    for x in range(grid.width)
+                    if expected.cells[y * grid.width + x] == 100
+                ]
+
+                def effective():
+                    return bool(fresh_costmap) and all(
+                        not fresh_costmap[0].free(p) for p in blocked
+                    )
+
+                while not effective() and time.monotonic() < deadline:
+                    executor.spin_once(timeout_sec=0.05)
+                if not effective():
+                    raise MapCatalogError("KEEPOUT_RUNTIME_UNAVAILABLE")
+        except MapCatalogError:
+            raise
+        except Exception as exc:
+            raise MapCatalogError("KEEPOUT_RUNTIME_UNAVAILABLE") from exc
+        finally:
+            if handle:
+                self._close(*handle)
