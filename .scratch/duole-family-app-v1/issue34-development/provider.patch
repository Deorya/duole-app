+        label="安全处理",
+        priority=TaskPriority.FALL_SAFETY,
+        resources=(TaskResource.MOTION,),
+        interruptible=False,
+    )
+    assert safety.accepted and safety.preempted_tasks[0].task_id == active.task_id
+    service2, executor2, coordinator2, request2 = setup(tmp_path / "busy")
+    coordinator2.start_task(
+        task_id="voice_goal",
+        domain="navigation",
+        task_type="go_to_waypoint",
+        label="语音导航",
+        priority=TaskPriority.USER_COMMAND,
+        resources=(TaskResource.MOTION,),
+        interruptible=True,
+    )
+    assert service2.execute(request2)["status"] == "failed" and not executor2.commands
+    assert coordinator2.active_tasks()[0].task_id == "voice_goal"
+
+
+def setup(tmp_path, *, success=True):
+    class Executor:
+        commands = []
+
+        def execute_command(self, command):
+            self.commands.append(command)
+            return NavigationCommandExecutionResult(
+                action=command["action"],
+                goal_key=command["goal_key"],
+                attempted=True,
+                success=success,
+                error=None if success else "navigation_unavailable",
+            )
+
+    executor = Executor()
+    coordinator = TaskCoordinator()
+    tracked = TrackingNavigationCommandExecutor(executor, coordinator)
+    service = SemanticNavigationRuntime(
+        tmp_path / "stop.sqlite3",
+        executor=tracked,
+        coordinator=coordinator,
+        ready=lambda: True,
+    )
+    now = datetime.now(timezone.utc)
+    request = AppReadRequest(
+        "navigateToSemanticTarget",
+        "req_nav_01",
+        now,
+        deadline_at=now + timedelta(seconds=30),
+        parameters={
+            "actor_id": "actor_a",
+            "idempotency_key": "idem_a",
+            "map_id": "map_a",
+            "map_revision": 1,
+            "expected_revision": 2,
+            "target": {
+                "kind": "room",
+                "entity_id": "room_" + "a" * 32,
+                "display_name": "厨房",
+                "target": {"x_m": 1.25, "y_m": 0.75},
+            },
+        },
+    )
+    return service, executor, coordinator, request
+
+
+def test_nav_uses_verified_target_once_and_is_owned_by_app_for_stop(tmp_path):
+    service, executor, coordinator, request = setup(tmp_path)
+    result = service.execute(request)
+    assert result["status"] == "accepted"
+    assert executor.commands[0]["waypoint"]["x"] == 1.25
+    assert executor.commands[0]["waypoint"]["y"] == 0.75
+    assert coordinator.active_tasks()[0].metadata["control_owner"] == "app"
+    assert service.execute(request) == result and len(executor.commands) == 1
+    coordinator.cancel_app_motion_tasks(operation_id="stop_test")
+    assert not coordinator.active_tasks()
+
+
+def test_stop_inhibit_and_disabled_readiness_reject_new_motion(tmp_path):
+    service, executor, _, request = setup(tmp_path)
+    service.leases.revoke_all_and_lock(
+        operation_id="stop_" + "a" * 32, revoked_at=request.requested_at
+    )
+    assert service.execute(request)["status"] == "failed" and not executor.commands
+    service2, executor2, _, request2 = setup(tmp_path / "second")
+    service2.ready = lambda: False
+    assert service2.execute(request2)["status"] == "failed" and not executor2.commands
+
+
+def test_failed_dispatch_is_not_arrival_and_cannot_be_replayed_as_motion(tmp_path):
+    service, executor, coordinator, request = setup(tmp_path, success=False)
+    result = service.execute(request)
+    assert result["status"] == "failed" and not coordinator.active_tasks()
+    assert service.execute(request) == result and len(executor.commands) == 1
+
+
+def test_lost_dispatch_ack_stays_uncertain_without_second_motion(tmp_path):
+    service, executor, _, request = setup(tmp_path)
+
+    def lost(command):
+        executor.commands.append(command)
+        raise OSError("lost ack")
+
+    service.executor.execute_command = lost
+    assert service.execute(request)["status"] == "unconfirmed"
+    assert (
+        service.execute(request)["status"] == "unconfirmed"
+        and len(executor.commands) == 1
+    )
