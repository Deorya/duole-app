+
+    first = request(http_setup)
+    app, credentials, key, authorization, presence, _, _ = http_setup
+    later = NOW + timedelta(seconds=1)
+    app._clock = lambda: later
+    app.pairing_service._clock = lambda: later
+    authorization._clock = lambda: later
+    path = "/api/v1/navigation/maps/map_a/semantics/commands"
+    body = {
+        "action": "room_upsert",
