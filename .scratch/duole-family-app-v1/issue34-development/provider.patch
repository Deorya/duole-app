+    (other / "keepout.pgm").write_bytes(b"other map")
+    with catalog._connect() as c:
+        c.execute("UPDATE map_catalog SET active=0 WHERE map_id='map_a'")
+    catalog.trash_map("map_a", expected_revision=1, now=NOW)
+    BoardMapCatalogService(catalog).handle(
