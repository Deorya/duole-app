diff --git a/duole_central/navigation_board/map_semantics.py b/duole_central/navigation_board/map_semantics.py
new file mode 100644
--- /dev/null
+++ b/duole_central/navigation_board/map_semantics.py
@@ -0,0 +1,752 @@
+"""Map-bound semantic configuration. Only board-verified targets can be saved."""
+
+from __future__ import annotations
+
+from collections import deque
+from copy import deepcopy
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from io import BytesIO
+import hashlib
+import json
+import math
+import re
+import sqlite3
+import unicodedata
+import uuid
+import zipfile
+
+from duole_central.app_gateway.map_catalog import MapCatalogError
+from duole_central.app_gateway.map_preview import MAX_PGM_PIXELS, pgm_pixels
+
+
+@dataclass(frozen=True)
+class Grid:
+    width: int
+    height: int
+    resolution: float
+    origin: tuple[float, float, float]
+    cells: tuple[int, ...]
+
+    def cell(self, point):
+        x, y = point["x_m"] - self.origin[0], point["y_m"] - self.origin[1]
+        c, s = math.cos(self.origin[2]), math.sin(self.origin[2])
+        px, py = (c * x + s * y) / self.resolution, (-s * x + c * y) / self.resolution
+        if px < 0 or py < 0 or px >= self.width - 1e-10 or py >= self.height - 1e-10:
+            return None
+        col, row = math.floor(px), math.floor(py)
+        return (col, row) if 0 <= col < self.width and 0 <= row < self.height else None
+
+    def point(self, cell):
+        x, y = (cell[0] + 0.5) * self.resolution, (cell[1] + 0.5) * self.resolution
+        c, s = math.cos(self.origin[2]), math.sin(self.origin[2])
+        return {
+            "x_m": self.origin[0] + c * x - s * y,
+            "y_m": self.origin[1] + s * x + c * y,
+        }
+
+    def free(self, point):
+        cell = self.cell(point)
+        return cell is not None and self.cells[cell[1] * self.width + cell[0]] == 0
+
+
+@dataclass(frozen=True)
+class SemanticObservation:
+    map_id: str
+    map_revision: int
+    grid: Grid
+    costmap: Grid
+    robot_position: dict
+    observed_at: datetime
+    localization_trusted: bool
+
+
+def artifact_grid(artifact):
+    with zipfile.ZipFile(BytesIO(artifact)) as archive:
+        if (
+            archive.getinfo("map.pgm").file_size > MAX_PGM_PIXELS + 4096
+            or archive.getinfo("map.yaml").file_size > 65536
+        ):
+            raise MapCatalogError("MAP_METADATA_INVALID")
+        width, height, pixels = pgm_pixels(archive.read("map.pgm"))
+        text = archive.read("map.yaml").decode("utf-8")
+
+    def scalar(name, default=None):
+        match = re.search(r"(?m)^" + name + r":\s*([^#\r\n]+)", text)
+        if match is None and default is None:
+            raise MapCatalogError("MAP_METADATA_INVALID")
+        return float(match[1]) if match else default
+
+    origin = re.search(r"(?m)^origin:\s*\[([^\]]+)\]", text)
+    if origin is None:
+        raise MapCatalogError("MAP_METADATA_INVALID")
+    origin = tuple(float(x.strip()) for x in origin[1].split(","))
+    resolution = scalar("resolution")
+    if (
+        len(origin) != 3
+        or not all(math.isfinite(x) for x in (*origin, resolution))
+        or resolution <= 0
+    ):
+        raise MapCatalogError("MAP_METADATA_INVALID")
+    free, occupied, negate = (
+        scalar("free_thresh", 0.196),
+        scalar("occupied_thresh", 0.65),
+        scalar("negate", 0),
+    )
+    if not 0 <= free < occupied <= 1 or negate not in (0, 1):
+        raise MapCatalogError("MAP_METADATA_INVALID")
+    values = tuple(
+        pixels[(height - 1 - y) * width + x]
+        for y in range(height)
+        for x in range(width)
+    )
+
+    def occupancy(value):
+        probability = value / 255 if negate else (255 - value) / 255
+        return 0 if probability < free else 100 if probability > occupied else -1
+
+    return Grid(width, height, resolution, origin, tuple(occupancy(x) for x in values))
+
+
+def same_grid(a, b):
+    return (
+        a.width == b.width
+        and a.height == b.height
+        and math.isclose(a.resolution, b.resolution, rel_tol=1e-6, abs_tol=1e-8)
+        and all(
+            math.isclose(x, y, rel_tol=0, abs_tol=1e-6)
+            for x, y in zip(a.origin, b.origin)
+        )
+        and a.cells == b.cells
+    )
+
+
+def position(value):
+    if (
+        not isinstance(value, dict)
+        or set(value) != {"x_m", "y_m"}
+        or any(
+            isinstance(x, bool)
+            or not isinstance(x, (float, int))
+            or not math.isfinite(x)
+            for x in value.values()
+        )
+    ):
+        raise MapCatalogError("SEMANTIC_POSITION_INVALID")
+    return {k: float(v) for k, v in value.items()}
+
+
+def display_name(value):
+    if not isinstance(value, str):
+        raise MapCatalogError("SEMANTIC_NAME_INVALID")
+    value = unicodedata.normalize("NFKC", value).strip()
+    if (
+        not value
+        or len(value) > 80
+        or any(unicodedata.category(c).startswith("C") for c in value)
+    ):
+        raise MapCatalogError("SEMANTIC_NAME_INVALID")
+    return value
+
+
+def inside(point, polygon):
+    x, y = point["x_m"], point["y_m"]
+    result = False
+    for a, b in zip(polygon, polygon[1:] + polygon[:1]):
+        ax, ay, bx, by = a["x_m"], a["y_m"], b["x_m"], b["y_m"]
+        cross = (x - ax) * (by - ay) - (y - ay) * (bx - ax)
+        if (
+            abs(cross) < 1e-9
+            and min(ax, bx) - 1e-9 <= x <= max(ax, bx) + 1e-9
+            and min(ay, by) - 1e-9 <= y <= max(ay, by) + 1e-9
+        ):
+            return True
+        if (ay > y) != (by > y) and x < (bx - ax) * (y - ay) / (by - ay) + ax:
+            result = not result
+    return result
+
+
+def polygon_geometry(raw, grid):
+    if not isinstance(raw, list) or not 3 <= len(raw) <= 64:
+        raise MapCatalogError("KEEPOUT_GEOMETRY_INVALID")
+    points = [position(x) for x in raw]
+    if any(grid.cell(x) is None for x in points):
+        raise MapCatalogError("KEEPOUT_OUT_OF_BOUNDS")
+    if len({(p["x_m"], p["y_m"]) for p in points}) != len(points):
+        raise MapCatalogError("KEEPOUT_GEOMETRY_INVALID")
+    area = sum(
+        a["x_m"] * b["y_m"] - b["x_m"] * a["y_m"]
+        for a, b in zip(points, points[1:] + points[:1])
+    )
+    if abs(area) < grid.resolution**2:
+        raise MapCatalogError("KEEPOUT_GEOMETRY_INVALID")
+
+    def orientation(a, b, c):
+        return (b["x_m"] - a["x_m"]) * (c["y_m"] - a["y_m"]) - (b["y_m"] - a["y_m"]) * (
+            c["x_m"] - a["x_m"]
+        )
+
+    def intersects(a, b, c, d):
+        oa, ob, oc, od = (
+            orientation(a, b, c),
+            orientation(a, b, d),
+            orientation(c, d, a),
+            orientation(c, d, b),
+        )
+        if oa * ob < 0 and oc * od < 0:
+            return True
+
+        def on(a, b, p):
+            return (
+                abs(orientation(a, b, p)) < 1e-9
+                and min(a["x_m"], b["x_m"]) <= p["x_m"] <= max(a["x_m"], b["x_m"])
+                and min(a["y_m"], b["y_m"]) <= p["y_m"] <= max(a["y_m"], b["y_m"])
+            )
+
+        return on(a, b, c) or on(a, b, d) or on(c, d, a) or on(c, d, b)
+
+    edges = list(zip(points, points[1:] + points[:1]))
+    for i, (a, b) in enumerate(edges):
+        for j, (c, d) in enumerate(edges):
+            if (
+                j > i + 1
+                and not (i == 0 and j == len(edges) - 1)
+                and intersects(a, b, c, d)
+            ):
+                raise MapCatalogError("KEEPOUT_GEOMETRY_INVALID")
+    return points
+
+
+class BoardMapSemantics:
+    def __init__(
+        self, catalog, *, observation_provider=None, keepout_applier=None, clock=None
+    ):
+        self.clock = clock or (lambda: datetime.now(timezone.utc))
+        self.catalog = catalog
+        self.observation_provider = observation_provider
+        self.keepout_applier = keepout_applier
+        with catalog._connect() as c:
+            c.executescript("""
+              CREATE TABLE IF NOT EXISTS map_semantics_versions(
+                map_id TEXT PRIMARY KEY REFERENCES map_catalog(map_id) ON DELETE CASCADE,
+                revision INTEGER NOT NULL);
+              CREATE TABLE IF NOT EXISTS map_semantics_keepout_pending(
+                map_id TEXT PRIMARY KEY REFERENCES map_catalog(map_id) ON DELETE CASCADE,
+                map_revision INTEGER NOT NULL);
+              CREATE TABLE IF NOT EXISTS map_semantics_requests(
+                map_id TEXT NOT NULL REFERENCES map_catalog(map_id) ON DELETE CASCADE,
+                actor_id TEXT NOT NULL, idempotency_key TEXT NOT NULL,
+                digest TEXT NOT NULL, result_json TEXT NOT NULL,
+                PRIMARY KEY(map_id,actor_id,idempotency_key));
+            """)
+
+    def _row(self, c, map_id):
+        c.row_factory = sqlite3.Row
+        row = c.execute(
+            "SELECT * FROM map_catalog WHERE map_id=? AND deleted_at IS NULL", (map_id,)
+        ).fetchone()
+        if row is None:
+            raise MapCatalogError("MAP_NOT_FOUND")
+        return row
+
+    def _revision(self, c, map_id):
+        row = c.execute(
+            "SELECT revision FROM map_semantics_versions WHERE map_id=?", (map_id,)
+        ).fetchone()
+        return row[0] if row else 1
+
+    def _data(self, c, row):
+        grid = artifact_grid(bytes(row["artifact"]))
+        image = self.catalog.read_image(
+            map_id=row["map_id"], map_revision=row["source_revision"]
+        )
+        configuration = json.loads(row["configuration_json"])
+        # Legacy configuration has no verification binding; it never becomes a usable target implicitly.
+        rooms = [
+            r
+            for r in configuration["rooms"]
+            if r.get("map_id") == row["map_id"]
+            and r.get("map_revision") == row["source_revision"]
+            and "target" in r
+        ]
+        return {
+            "map_id": row["map_id"],
+            "map_revision": row["source_revision"],
+            "revision": self._revision(c, row["map_id"]),
+            "active": bool(row["active"]),
+            "quality_warning": json.loads(row["quality_json"])["overall_score"] < 60,
+            "map": {
+                "map_id": row["map_id"],
+                "revision": row["source_revision"],
+                "content_sha256": hashlib.sha256(image.body).hexdigest(),
+                "width_px": grid.width,
+                "height_px": grid.height,
+                "resolution_m_per_px": grid.resolution,
+                "origin": {
+                    "x_m": grid.origin[0],
+                    "y_m": grid.origin[1],
+                    "yaw_rad": grid.origin[2],
+                },
+                "updated_at": row["updated_at"],
+                "image_resource": {
+                    "href": f"/api/v1/navigation/maps/{row['map_id']}/revisions/{row['source_revision']}/image",
+                    "etag": image.etag,
+                    "content_type": "image/png",
+                },
+            },
+            "rooms": rooms,
+            "keepout_zones": configuration["keepout_zones"],
+            "patrol_routes": configuration["patrol_routes"],
+            "dock_pose": self._dock(configuration.get("dock_anchor"), row),
+        }
+
+    @staticmethod
+    def _dock(anchor, row):
+        if (
+            not isinstance(anchor, dict)
+            or row["dock_anchor_status"] != "verified"
+            or anchor.get("anchor_id") != row["dock_anchor_id"]
+            or anchor.get("status") != "verified"
+            or anchor.get("map_id") != row["map_id"]
+            or anchor.get("map_revision") != row["source_revision"]
+        ):
+            return None
+        try:
+            point = position(anchor["position"])
+            yaw = float(anchor["yaw_rad"])
+        except (KeyError, ValueError, TypeError, MapCatalogError):
+            return None
+        if not math.isfinite(yaw):
+            return None
+        return {
+            "map_id": row["map_id"],
+            "map_revision": row["source_revision"],
+            "frame_id": "map",
+            "position": point,
+            "yaw_rad": yaw,
+        }
+
+    def read(self, *, map_id):
+        with self.catalog._connect() as c:
+            return self._data(c, self._row(c, map_id))
+
+    def _observation(self, row, now):
+        if row["technical_state"] != "loadable":
+            raise MapCatalogError("SEMANTIC_MAP_UNUSABLE")
+        if row["technical_reason"] == "localization_pending":
+            raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED")
+        if not row["active"]:
+            raise MapCatalogError("SEMANTIC_ACTIVE_MAP_REQUIRED")
+        if self.observation_provider is None:
+            raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED")
+        observation = self.observation_provider(row["map_id"], row["source_revision"])
+        age = (self.clock() - observation.observed_at).total_seconds()
+        if not observation.localization_trusted or not 0 <= age <= 2:
+            raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED")
+        if (
+            observation.map_id != row["map_id"]
+            or observation.map_revision != row["source_revision"]
+            or not same_grid(observation.grid, artifact_grid(bytes(row["artifact"])))
+        ):
+            raise MapCatalogError(
+                "MAP_REVISION_CONFLICT", current_revision=row["source_revision"]
+            )
+        return observation
+
+    @staticmethod
+    def _candidate(point, observation, configuration, *, exact=False):
+        grid = observation.grid
+        if grid.cell(point) is None:
+            raise MapCatalogError("ROOM_OUT_OF_BOUNDS")
+        zones = [z["polygon"] for z in configuration["keepout_zones"]]
+
+        def safe(p):
+            return (
+                grid.free(p)
+                and observation.costmap.free(p)
+                and not any(inside(p, z) for z in zones)
+            )
+
+        start = grid.cell(observation.robot_position)
+        if start is None or not safe(grid.point(start)):
+            raise MapCatalogError("SEMANTIC_LOCALIZATION_UNTRUSTED")
+        frontier = deque([start])
+        visited = {start}
+        best = None
+        distance = float("inf")
+        while frontier:
+            cell = frontier.popleft()
+            p = grid.point(cell)
+            d = math.hypot(p["x_m"] - point["x_m"], p["y_m"] - point["y_m"])
+            if d <= (grid.resolution * 0.75 if exact else 1.0) and d < distance:
+                best, distance = p, d
+            for next_cell in (
+                (cell[0] - 1, cell[1]),
+                (cell[0] + 1, cell[1]),
+                (cell[0], cell[1] - 1),
+                (cell[0], cell[1] + 1),
+            ):
+                x, y = next_cell
+                if (
+                    0 <= x < grid.width
+                    and 0 <= y < grid.height
+                    and next_cell not in visited
+                ):
+                    visited.add(next_cell)
+                    if safe(grid.point(next_cell)):
+                        frontier.append(next_cell)
+        if best is None:
+            raise MapCatalogError("ROOM_SAFE_TARGET_NOT_FOUND")
+        return best
+
+    def execute(self, *, map_id, body, actor_id, idempotency_key, now, request_id=None):
+        allowed = {
+            "action",
+            "map_revision",
+            "expected_revision",
+            "presence_token",
+            "entity_id",
+            "display_name",
+            "approximate_position",
+            "polygon",
+            "room_ids",
+        }
+        required = {"action", "map_revision", "expected_revision", "presence_token"}
+        if (
+            not isinstance(body, dict)
+            or set(body) - allowed
+            or not required <= set(body)
+        ):
+            raise MapCatalogError("SEMANTIC_REQUEST_INVALID")
+        action = body["action"]
+        field_sets = {
+            "room_upsert": {"display_name", "approximate_position"},
+            "validate_room": {"display_name", "approximate_position"},
+            "keepout_upsert": {"display_name", "polygon"},
+            "route_upsert": {"display_name", "room_ids"},
+            "room_delete": {"entity_id"},
+            "keepout_delete": {"entity_id"},
+            "route_delete": {"entity_id"},
+        }
+        if (
+            action not in field_sets
+            or not field_sets[action] <= set(body)
+            or set(body)
+            - required
+            - field_sets[action]
+            - (
+                {"entity_id"}
+                if action.endswith("_upsert") or action == "validate_room"
+                else set()
+            )
+        ):
+            raise MapCatalogError("SEMANTIC_REQUEST_INVALID")
+        for key in ("map_revision", "expected_revision"):
+            if (
+                isinstance(body[key], bool)
+                or not isinstance(body[key], int)
+                or body[key] < 1
+            ):
+                raise MapCatalogError("SEMANTIC_REQUEST_INVALID")
+        digest = hashlib.sha256(
+            json.dumps(
+                {k: v for k, v in body.items() if k != "presence_token"},
+                sort_keys=True,
+                ensure_ascii=False,
+                separators=(",", ":"),
+            ).encode()
+        ).hexdigest()
+        with self.catalog._connect() as c:
+            c.execute("BEGIN IMMEDIATE")
+            row = self._row(c, map_id)
+            pending = c.execute(
+                "SELECT map_revision FROM map_semantics_keepout_pending WHERE map_id=?",
+                (map_id,),
+            ).fetchone()
+            if pending is not None:
+                if pending[0] != row["source_revision"] or self.keepout_applier is None:
+                    raise MapCatalogError("KEEPOUT_RESTORE_UNCONFIRMED")
+                observation = self._observation(row, now)
+                persisted = json.loads(row["configuration_json"])
+                try:
+                    self.keepout_applier(observation.grid, persisted["keepout_zones"])
+                except Exception as exc:
+                    raise MapCatalogError("KEEPOUT_RESTORE_UNCONFIRMED") from exc
+                c.execute(
+                    "DELETE FROM map_semantics_keepout_pending WHERE map_id=?",
+                    (map_id,),
+                )
+                c.commit()
+                c.execute("BEGIN IMMEDIATE")
+                row = self._row(c, map_id)
+            replay = c.execute(
+                "SELECT digest,result_json FROM map_semantics_requests WHERE map_id=? AND actor_id=? AND idempotency_key=?",
+                (map_id, actor_id, idempotency_key),
+            ).fetchone()
+            if replay:
+                if replay[0] != digest:
+                    raise MapCatalogError("IDEMPOTENCY_CONFLICT")
+                saved = json.loads(replay[1])
+                if request_id is None:
+                    saved.pop("_response", None)
+                return saved
+            revision = self._revision(c, map_id)
+            if row["source_revision"] != body["map_revision"]:
+                raise MapCatalogError(
+                    "MAP_REVISION_CONFLICT", current_revision=row["source_revision"]
+                )
+            if revision != body["expected_revision"]:
+                raise MapCatalogError(
+                    "SEMANTIC_REVISION_CONFLICT", current_revision=revision
+                )
+            observation = self._observation(row, now)
+            configuration = json.loads(row["configuration_json"])
+            original = deepcopy(configuration)
+            kind = (
+                "rooms"
+                if action in ("room_upsert", "room_delete", "validate_room")
+                else (
+                    "keepout_zones" if action.startswith("keepout") else "patrol_routes"
+                )
+            )
+            entries = configuration[kind]
+            entity_id = body.get("entity_id")
+            if entity_id is not None and (
+                not isinstance(entity_id, str)
+                or re.fullmatch(r"(room|keepout|route)_[0-9a-f]{32}", entity_id) is None
+            ):
+                raise MapCatalogError("SEMANTIC_ENTITY_INVALID")
+            existing = (
+                next((x for x in entries if x.get("id") == entity_id), None)
+                if entity_id
+                else None
+            )
+            if entity_id and existing is None:
+                raise MapCatalogError("SEMANTIC_ENTITY_NOT_FOUND")
+            if action.endswith("_delete"):
+                if kind == "rooms" and any(
+                    entity_id in r["room_ids"] for r in configuration["patrol_routes"]
+                ):
+                    raise MapCatalogError("ROOM_REFERENCED_BY_ROUTE")
+                entries.remove(existing)
+            else:
+                name = display_name(body["display_name"])
+                if kind == "rooms" and name == "充电桩":
+                    raise MapCatalogError("ROOM_DOCK_RESERVED")
+                if any(
+                    display_name(x["display_name"]).casefold() == name.casefold()
+                    and x.get("id") != entity_id
+                    for x in entries
+                ):
+                    raise MapCatalogError("SEMANTIC_NAME_CONFLICT")
+                entity = {
+                    "id": entity_id
+                    or f"{ {'rooms':'room','keepout_zones':'keepout','patrol_routes':'route'}[kind]}_{uuid.uuid4().hex}",
+                    "display_name": name,
+                    "map_id": map_id,
+                    "map_revision": row["source_revision"],
+                    "verification": "verified",
+                }
+                if kind == "rooms":
+                    point = position(body["approximate_position"])
+                    candidate = self._candidate(point, observation, configuration)
+                    entity.update(approximate_position=point, target=candidate)
+                    if action == "validate_room":
+                        return {
+                            "candidate": candidate,
+                            "map_id": map_id,
+                            "map_revision": row["source_revision"],
+                            "revision": revision,
+                        }
+                elif kind == "keepout_zones":
+                    entity["polygon"] = polygon_geometry(
+                        body["polygon"], observation.grid
+                    )
+                    if inside(observation.robot_position, entity["polygon"]):
+                        raise MapCatalogError("KEEPOUT_CONTAINS_ROBOT")
+                    if existing:
+                        entries.remove(existing)
+                    entries.append(entity)
+                    for room in configuration["rooms"]:
+                        if room.get("verification") == "verified":
+                            self._candidate(
+                                room["target"], observation, configuration, exact=True
+                            )
+                    entity = None
+                else:
+                    room_ids = body["room_ids"]
+                    if (
+                        not isinstance(room_ids, list)
+                        or not 2 <= len(room_ids) <= 64
+                        or not all(isinstance(x, str) for x in room_ids)
+                        or len(set(room_ids)) != len(room_ids)
+                    ):
+                        raise MapCatalogError("ROUTE_ROOMS_INVALID")
+                    rooms = {
+                        r["id"]: r
+                        for r in configuration["rooms"]
+                        if r.get("verification") == "verified"
+                        and r.get("map_revision") == row["source_revision"]
+                    }
+                    for room_id in room_ids:
+                        if room_id not in rooms:
+                            raise MapCatalogError("ROUTE_ROOM_UNVERIFIED")
+                        self._candidate(
+                            rooms[room_id]["target"],
+                            observation,
+                            configuration,
+                            exact=True,
+                        )
+                    entity["room_ids"] = room_ids
+                if entity is not None:
+                    if existing:
+                        entries.remove(existing)
+                    entries.append(entity)
+            changed = configuration != original
+            if kind == "keepout_zones" and changed:
+                if self.keepout_applier is None:
+                    raise MapCatalogError("KEEPOUT_RUNTIME_UNAVAILABLE")
+                # Journal before the ROS side effect; a retry restores the persisted mask first.
+                c.execute(
+                    "INSERT INTO map_semantics_keepout_pending VALUES (?,?)",
+                    (map_id, row["source_revision"]),
+                )
+                c.commit()
+                c.execute("BEGIN IMMEDIATE")
+                try:
+                    self.keepout_applier(
+                        observation.grid, configuration["keepout_zones"]
+                    )
+                    observation = self._observation(row, now)
+                    for room in configuration["rooms"]:
+                        if room.get("verification") == "verified":
+                            self._candidate(
+                                room["target"], observation, configuration, exact=True
+                            )
+                except Exception:
+                    c.rollback()
+                    try:
+                        self.keepout_applier(
+                            observation.grid, original["keepout_zones"]
+                        )
+                    except Exception as exc:
+                        raise MapCatalogError("KEEPOUT_RESTORE_UNCONFIRMED") from exc
+                    c.execute(
+                        "DELETE FROM map_semantics_keepout_pending WHERE map_id=?",
+                        (map_id,),
+                    )
+                    c.commit()
+                    raise
+            try:
+                new_revision = revision + int(changed)
+                c.execute(
+                    "UPDATE map_catalog SET configuration_json=?,updated_at=? WHERE map_id=?",
+                    (
+                        json.dumps(
+                            configuration, ensure_ascii=False, separators=(",", ":")
+                        ),
+                        now.isoformat(),
+                        map_id,
+                    ),
+                )
+                c.execute(
+                    "INSERT INTO map_semantics_versions VALUES (?,?) ON CONFLICT(map_id) DO UPDATE SET revision=excluded.revision",
+                    (map_id, new_revision),
+                )
+                result = self._data(c, self._row(c, map_id))
+                c.execute(
+                    "INSERT INTO map_semantics_requests VALUES (?,?,?,?,?)",
+                    (
+                        map_id,
+                        actor_id,
+                        idempotency_key,
+                        digest,
+                        json.dumps(
+                            {
+                                **result,
+                                "_response": {
+                                    "request_id": request_id or "req_internal_semantic",
+                                    "server_time": now.isoformat(),
+                                },
+                            },
+                            ensure_ascii=False,
+                        ),
+                    ),
+                )
+                c.execute(
+                    "DELETE FROM map_semantics_keepout_pending WHERE map_id=?",
+                    (map_id,),
+                )
+                self.catalog._fault_injector("semantics.before_commit")
+                c.commit()
+            except Exception:
+                if kind == "keepout_zones" and changed:
+                    c.rollback()
+                    try:
+                        persisted = self.catalog.read_configuration(map_id)
+                        self.keepout_applier(
+                            observation.grid, list(persisted.keepout_zones)
+                        )
+                    except Exception as exc:
+                        raise MapCatalogError("KEEPOUT_RESTORE_UNCONFIRMED") from exc
+                    c.execute(
+                        "DELETE FROM map_semantics_keepout_pending WHERE map_id=?",
+                        (map_id,),
+                    )
+                    c.commit()
+                raise
+            if request_id is not None:
+                result["_response"] = {
+                    "request_id": request_id,
+                    "server_time": now.isoformat(),
+                }
+            return result
+
+    def resolve_target(
+        self, *, map_id, entity_id, map_revision, expected_revision, now
+    ):
+        with self.catalog._connect() as c:
+            row = self._row(c, map_id)
+            if (
+                row["source_revision"] != map_revision
+                or self._revision(c, map_id) != expected_revision
+            ):
+                raise MapCatalogError(
+                    "SEMANTIC_REVISION_CONFLICT",
+                    current_revision=self._revision(c, map_id),
+                )
+            if c.execute(
+                "SELECT 1 FROM map_semantics_keepout_pending WHERE map_id=?", (map_id,)
+            ).fetchone():
+                raise MapCatalogError("KEEPOUT_RESTORE_UNCONFIRMED")
+            observation = self._observation(row, now)
+            configuration = json.loads(row["configuration_json"])
+            if entity_id == "charging_dock":
+                dock = self._dock(configuration.get("dock_anchor"), row)
+                if dock is None:
+                    raise MapCatalogError("DOCK_ANCHOR_UNVERIFIED")
+                return {
+                    "kind": "dock",
+                    "entity_id": entity_id,
+                    "display_name": "充电桩",
+                    "target": dock["position"],
+                }
+            room = next(
+                (
+                    r
+                    for r in configuration["rooms"]
+                    if r.get("id") == entity_id
+                    and r.get("verification") == "verified"
+                    and r.get("map_revision") == map_revision
+                ),
+                None,
+            )
+            if room is None:
+                raise MapCatalogError("ROOM_UNVERIFIED")
+            self._candidate(room["target"], observation, configuration, exact=True)
+            return {
+                "kind": "room",
+                "entity_id": entity_id,
+                "display_name": room["display_name"],
+                "target": room["target"],
+            }
