diff --git a/duole_central/app_gateway/map_semantics.py b/duole_central/app_gateway/map_semantics.py
new file mode 100644
--- /dev/null
+++ b/duole_central/app_gateway/map_semantics.py
@@ -0,0 +1,264 @@
+"""Signed, present-at-robot semantic writes and ID-only navigation requests."""
+
+from datetime import datetime, timedelta
+import re
+import hashlib
+import sqlite3
+
+from duole_central.app_gateway.map_catalog import MapCatalogError
+from duole_central.app_gateway.map_management import MapManagementAuthorizationError
+from duole_central.app_gateway.models import AppReadRequest
+from duole_central.app_gateway.pairing import PairingError
+
+
+def semantic_response(
+    application,
+    method,
+    path,
+    headers,
+    body,
+    *,
+    map_id,
+    suffix,
+    request_id,
+    now,
+    peer_ip,
+):
+    from duole_central.app_gateway.gateway import (
+        _bearer_token,
+        _error_response,
+        _success_response,
+        _installation_command_proof,
+        _header,
+        _pairing_error_response,
+    )
+
+    def error(code, reason, status=409, details=None):
+        return _error_response(
+            status=status,
+            request_id=request_id,
+            server_time=now,
+            code=code,
+            message="点位配置或导航请求未完成",
+            retriable=True,
+            remediation="请刷新地图、定位和现场会话后重试",
+            details={"reason_code": reason, **(details or {})},
+        )
+
+    catalog = application.map_catalog
+    if catalog is None or not hasattr(catalog, "read_semantics"):
+        return error("CAPABILITY_UNAVAILABLE", "semantics_unavailable", 503)
+    if method == "GET":
+        denied = application._validate_read_metadata(
+            headers, request_id=request_id, requested_at=now
+        ) or application._authorize_read(
+            headers, request_id=request_id, requested_at=now
+        )
+        if denied is not None:
+            return denied
+    else:
+        denied = application._validate_command_metadata(
+            headers, request_id=request_id, requested_at=now
+        )
+        if denied is not None:
+            return denied
+        if application.pairing_service is None:
+            return error("AUTHENTICATION_REQUIRED", "pairing_required", 401)
+        try:
+            actor = application.pairing_service.authenticate_bound_command(
+                _bearer_token(headers),
+                _installation_command_proof(
+                    headers, request_id=request_id, method=method, path=path, body=body
+                ),
+            )
+            required = (
+                "navigation.execute"
+                if suffix == "semantic-navigation"
+                else "maps.manage"
+            )
+            if required not in actor.scopes:
+                raise PairingError("AUTHORIZATION_DENIED")
+        except PairingError as exc:
+            return _pairing_error_response(
+                exc.code, request_id=request_id, server_time=now
+            )
+        lan = application._controlled_lan_id_provider(peer_ip)
+        if lan is None:
+            if (
+                suffix != "semantic-navigation"
+                and application.map_management_authorization_service is not None
+            ):
+                try:
+                    application.map_management_authorization_service.invalidate_map_management_presence(
+                        body.get("presence_token", ""),
+                        actor_id=actor.device_session_id,
+                        reason="controlled_lan_left",
+                    )
+                except MapManagementAuthorizationError:
+                    pass
+            return error("AUTHORIZATION_DENIED", "controlled_lan_required", 403)
+        if suffix != "semantic-navigation":
+            service = application.map_management_authorization_service
+            if service is None:
+                return error(
+                    "CAPABILITY_UNAVAILABLE", "map_management_unavailable", 503
+                )
+            action = body.get("action", "")
+            operation = (
+                "room_target"
+                if action in ("room_upsert", "room_delete", "validate_room")
+                else (
+                    "keepout_zone"
+                    if action in ("keepout_upsert", "keepout_delete")
+                    else (
+                        "patrol_route"
+                        if action in ("route_upsert", "route_delete")
+                        else None
+                    )
+                )
+            )
+            if operation is None or (
+                suffix.endswith("validate-room") != (action == "validate_room")
+            ):
+                return error("VALIDATION_FAILED", "semantic_request_invalid", 400)
+            if not isinstance(body.get("presence_token"), str):
+                return error("VALIDATION_FAILED", "presence_token_required", 400)
+            try:
+                service.require_map_management_presence(
+                    body["presence_token"],
+                    actor_id=actor.device_session_id,
+                    installation_id=actor.installation_id,
+                    controlled_lan_id=lan,
+                    operation=operation,
+                )
+            except MapManagementAuthorizationError as exc:
+                return error("AUTHORIZATION_DENIED", exc.code.casefold(), 403)
+    response_request_id, response_time = request_id, now
+    edit_claim = None
+    release_edit = False
+    try:
+        if method == "GET":
+            data = catalog.read_semantics(map_id=map_id)
+        elif suffix == "semantic-navigation":
+            if (
+                set(body) != {"entity_id", "map_revision", "expected_revision"}
+                or not isinstance(body["entity_id"], str)
+                or re.fullmatch(r"(room_[0-9a-f]{32}|charging_dock)", body["entity_id"])
+                is None
+                or any(
+                    isinstance(body[k], bool)
+                    or not isinstance(body[k], int)
+                    or body[k] < 1
+                    for k in ("map_revision", "expected_revision")
+                )
+            ):
+                return error("VALIDATION_FAILED", "semantic_navigation_invalid", 400)
+            target = catalog.resolve_semantic_target(map_id=map_id, **body, now=now)
+            data = application.runtime_client.query(
+                AppReadRequest(
+                    operation_id="navigateToSemanticTarget",
+                    request_id=request_id,
+                    requested_at=now,
+                    deadline_at=now
+                    + timedelta(milliseconds=int(_header(headers, "X-TTL-Ms"))),
+                    parameters={
+                        "actor_id": actor.device_session_id,
+                        "idempotency_key": _header(headers, "Idempotency-Key"),
+                        "map_id": map_id,
+                        "map_revision": body["map_revision"],
+                        "expected_revision": body["expected_revision"],
+                        "target": target,
+                    },
+                )
+            ).data
+        else:
+            match = _header(headers, "If-Match")
+            if match != f'"rev-{body.get("expected_revision")}"':
+                return error("VALIDATION_FAILED", "semantic_if_match_required", 400)
+            edit_id = (
+                "semantic_edit_"
+                + hashlib.sha256(
+                    (
+                        actor.device_session_id
+                        + ":"
+                        + _header(headers, "Idempotency-Key")
+                    ).encode()
+                ).hexdigest()[:32]
+            )
+            edit_claim = {"operation_id": edit_id, "actor_id": actor.device_session_id}
+            claim = application.runtime_client.query(
+                AppReadRequest(
+                    "claimMapSemanticsEdit", request_id, now, parameters=edit_claim
+                )
+            )
+            if claim.data.get("accepted") is not True:
+                edit_claim = None
+                return error("CAPABILITY_UNAVAILABLE", "map_semantics_motion_busy")
+            data = catalog.write_semantics(
+                map_id=map_id,
+                body=dict(body),
+                actor_id=actor.device_session_id,
+                idempotency_key=_header(headers, "Idempotency-Key"),
+                now=now,
+                request_id=request_id,
+            )
+            metadata = data.pop("_response", None)
+            if metadata is not None:
+                response_request_id = metadata["request_id"]
+                response_time = datetime.fromisoformat(metadata["server_time"])
+        release_edit = True
+    except MapCatalogError as exc:
+        release_edit = exc.code != "KEEPOUT_RESTORE_UNCONFIRMED"
+        details = (
+            {"current_revision": exc.current_revision}
+            if exc.current_revision is not None
+            else {}
+        )
+        code = (
+            "REVISION_CONFLICT"
+            if "REVISION_CONFLICT" in exc.code
+            else (
+                "IDEMPOTENCY_CONFLICT"
+                if exc.code == "IDEMPOTENCY_CONFLICT"
+                else (
+                    "VALIDATION_FAILED"
+                    if "NOT_FOUND" in exc.code
+                    else (
+                        "VALIDATION_FAILED"
+                        if "INVALID" in exc.code or "OUT_OF_BOUNDS" in exc.code
+                        else "CAPABILITY_UNAVAILABLE"
+                    )
+                )
+            )
+        )
+        return error(
+            code,
+            exc.code.casefold(),
+            (
+                404
+                if "NOT_FOUND" in exc.code
+                else 400 if code == "VALIDATION_FAILED" else 409
+            ),
+            details,
+        )
+    except (sqlite3.Error, OSError, RuntimeError, ValueError):
+        return error("CAPABILITY_UNAVAILABLE", "semantic_service_unavailable", 503)
+    finally:
+        if edit_claim is not None and release_edit:
+            try:
+                application.runtime_client.query(
+                    AppReadRequest(
+                        "releaseMapSemanticsEdit",
+                        request_id,
+                        now,
+                        parameters=edit_claim,
+                    )
+                )
+            except (OSError, RuntimeError, ValueError):
+                pass  # An unconfirmed release remains a visible motion inhibit until stop/recovery.
+    return _success_response(
+        status=200,
+        request_id=response_request_id,
+        server_time=response_time,
+        data=dict(data),
+    )
