+def publication(map_id="map_a", *, active=True, cells=None):
+    width = 24
+    height = 24
+    pixels = bytes(
+        (
+            254
+            if cells is None or cells[(height - 1 - y) * width + x] == 0
+            else 0 if cells[(height - 1 - y) * width + x] == 100 else 205
+        )
+        for y in range(height)
+        for x in range(width)
+    )
+    pgm = f"P5\n{width} {height}\n255\n".encode() + pixels
+    archive = BytesIO()
+    with zipfile.ZipFile(archive, "w") as z:
+        z.writestr("map.pgm", pgm)
+        z.writestr(
+            "map.yaml",
+            "image: map.pgm\nresolution: 0.1\norigin: [0, 0, 0]\nnegate: 0\noccupied_thresh: 0.65\nfree_thresh: 0.196\n",
+        )
+    return MapCatalogPublication(
+        map_id,
+        1,
+        NOW,
+        NOW,
+        archive.getvalue(),
+        pgm_preview(pgm),
+        "unassigned",
+        "unverified",
+        MapQuality(78, 78, 78, 78, 78, ("map_quality_ready",)),
+        MapConfigurationBundle(),
+        active=active,
