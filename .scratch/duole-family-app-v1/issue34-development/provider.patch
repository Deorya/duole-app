diff --git a/duole_central/app_gateway/semantic_navigation.py b/duole_central/app_gateway/semantic_navigation.py
new file mode 100644
--- /dev/null
+++ b/duole_central/app_gateway/semantic_navigation.py
@@ -0,0 +1,182 @@
+"""Dispatch verified semantic IDs through the product's existing executor."""
+
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import sqlite3
+import threading
+import uuid
+
+from duole_central.app_gateway.emergency_stop import (
+    AppMotionLeaseDenied,
+    AppMotionLeaseRegistry,
+)
+from duole_central.skills.navigation.domain import (
+    TaskPriority,
+    TaskResource,
+    ResourceClaimMode,
+)
+
+
+class SemanticNavigationRuntime:
+    def __init__(self, database_path, *, executor, coordinator, ready=lambda: False):
+        self.path = Path(database_path)
+        self.executor = executor
+        self.coordinator = coordinator
+        self.ready = ready
+        self.leases = AppMotionLeaseRegistry(self.path)
+        self._lock = threading.Lock()
+        with self._connect() as c:
+            c.execute("""CREATE TABLE IF NOT EXISTS app_semantic_navigation_requests(
+                actor_id TEXT NOT NULL,idempotency_key TEXT NOT NULL,digest TEXT NOT NULL,
+                result_json TEXT NOT NULL, PRIMARY KEY(actor_id,idempotency_key))""")
+
+    def _connect(self):
+        return sqlite3.connect(self.path, timeout=1)
+
+    def _allowed(self):
+        with self._connect() as c:
+            row = c.execute(
+                "SELECT inhibited FROM app_motion_control WHERE singleton=1"
+            ).fetchone()
+        return row is not None and row[0] == 0 and self.ready()
+
+    def execute(self, request):
+        parameters = request.parameters
+        target = parameters["target"]
+        actor, key = parameters["actor_id"], parameters["idempotency_key"]
+        digest = hashlib.sha256(
+            json.dumps(
+                parameters, ensure_ascii=False, sort_keys=True, separators=(",", ":")
+            ).encode()
+        ).hexdigest()
+        with self._lock:
+            with self._connect() as c:
+                c.execute("BEGIN IMMEDIATE")
+                row = c.execute(
+                    "SELECT digest,result_json FROM app_semantic_navigation_requests WHERE actor_id=? AND idempotency_key=?",
+                    (actor, key),
+                ).fetchone()
+                if row:
+                    if row[0] != digest:
+                        raise ValueError("semantic_navigation_idempotency_conflict")
+                    return json.loads(row[1])
+                result = {
+                    "operation_id": "semantic_nav_" + uuid.uuid4().hex,
+                    "status": "unconfirmed",
+                    "entity_id": target["entity_id"],
+                    "display_name": target["display_name"],
+                    "reason_code": "navigation_dispatch_unconfirmed",
+                }
+                c.execute(
+                    "INSERT INTO app_semantic_navigation_requests VALUES (?,?,?,?)",
+                    (actor, key, digest, json.dumps(result, ensure_ascii=False)),
+                )
+            now = datetime.now(timezone.utc)
+            if (
+                request.deadline_at is None
+                or now >= request.deadline_at
+                or not self._allowed()
+            ):
+                result.update(status="failed", reason_code="navigation_unavailable")
+            else:
+                try:
+                    self.leases.acquire(
+                        lease_id=result["operation_id"], actor_id=actor, acquired_at=now
+                    )
+                    # Admit without replacing motion. Keep the existing navigation
+                    # domain and interruptibility so safety preemption still applies.
+                    with self.coordinator._lock:
+                        busy = any(
+                            TaskResource.MOTION in task.resources
+                            for task in self.coordinator.active_tasks()
+                        )
+                        decision = (
+                            None
+                            if busy
+                            else self.coordinator.start_task(
+                                task_id=result["operation_id"],
+                                domain="navigation",
+                                task_type="go_to_waypoint",
+                                label="前往" + target["display_name"],
+                                priority=TaskPriority.USER_COMMAND,
+                                resources=(TaskResource.MOTION,),
+                                resource_mode=ResourceClaimMode.EXCLUSIVE,
+                                interruptible=True,
+                                target=target["entity_id"],
+                                metadata={"control_owner": "app", "actor_id": actor},
+                                effect_planned=True,
+                            )
+                        )
+                    if decision is None or not decision.accepted:
+                        result.update(
+                            status="failed",
+                            reason_code="navigation_motion_resource_blocked",
+                        )
+                    elif not self._allowed():
+                        self.coordinator.complete_task(
+                            result["operation_id"],
+                            phase="failed",
+                            reason="app_motion_inhibited",
+                        )
+                        result.update(
+                            status="failed", reason_code="app_motion_inhibited"
+                        )
+                    else:
+                        point = target["target"]
+                        command = {
+                            "command_id": result["operation_id"],
+                            "action": "go_to_waypoint",
+                            "goal_key": (
+                                "charging_dock"
+                                if target["kind"] == "dock"
+                                else target["entity_id"]
+                            ),
+                            "source": "app",
+                            "request_source": "mobile_app",
+                            "control_owner": "app",
+                            "waypoint": {
+                                "display_name": target["display_name"],
+                                "frame_id": "map",
+                                "x": point["x_m"],
+                                "y": point["y_m"],
+                                "yaw": 0.0,
+                                "enabled": True,
+                            },
+                            "map_id": parameters["map_id"],
+                            "map_revision": parameters["map_revision"],
+                        }
+                        outcome = self.executor.execute_command(command)
+                        result.update(
+                            status="accepted" if outcome.success else "failed",
+                            reason_code=outcome.error,
+                        )
+                        if not self._allowed():
+                            self.executor.execute_command(
+                                {
+                                    "action": "cancel_goal",
+                                    "goal_key": command["goal_key"],
+                                    "reason": "app_motion_inhibited",
+                                    "request_source": "mobile_app",
+                                    "control_owner": "app",
+                                }
+                            )
+                            result.update(
+                                status="unconfirmed",
+                                reason_code="app_motion_stop_pending",
+                            )
+                except AppMotionLeaseDenied:
+                    result.update(status="failed", reason_code="app_motion_inhibited")
+                except Exception:
+                    # The persisted uncertain result prevents a second dispatch after a lost acknowledgement.
+                    result.update(
+                        status="unconfirmed",
+                        reason_code="navigation_dispatch_unconfirmed",
+                    )
+            with self._connect() as c:
+                c.execute(
+                    "UPDATE app_semantic_navigation_requests SET result_json=? WHERE actor_id=? AND idempotency_key=?",
+                    (json.dumps(result, ensure_ascii=False), actor, key),
+                )
+            return result
