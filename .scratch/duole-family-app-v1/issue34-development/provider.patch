+from datetime import datetime, timezone
+
+from duole_central.app_gateway.facade import AppGatewayDomainFacade
+from duole_central.app_gateway.models import AppRuntimeInfo, AppReadRequest
+from duole_central.skills.navigation.application import TaskCoordinator
+from duole_central.skills.navigation.domain import TaskPriority, TaskResource
+
+
+def request(op, actor="actor_a", identifier=None):
+    return AppReadRequest(
+        op,
+        "req_edit_01",
+        datetime.now(timezone.utc),
+        parameters={
+            "operation_id": identifier or "semantic_edit_" + "a" * 32,
+            "actor_id": actor,
+        },
+    )
+
+
+def test_semantic_edits_hold_shared_motion_resource_until_confirmed_release():
+    coordinator = TaskCoordinator()
+    facade = AppGatewayDomainFacade(
+        None,
+        runtime_info=AppRuntimeInfo("robot_a", "机器人", "duole"),
+        task_coordinator=coordinator,
+    )
+    assert facade.query(request("claimMapSemanticsEdit")).data["accepted"]
+    assert facade.query(request("claimMapSemanticsEdit")).data["accepted"]
+    denied = coordinator.start_task(
+        task_id="voice_goal",
+        domain="navigation",
+        task_type="go_to_waypoint",
+        label="前往厨房",
+        priority=TaskPriority.USER_COMMAND,
+        resources=(TaskResource.MOTION,),
+        interruptible=True,
+    )
+    assert not denied.accepted
+    assert facade.query(request("releaseMapSemanticsEdit")).data["accepted"]
+    assert not coordinator.active_tasks()
+
+
+def test_busy_robot_is_not_preempted_to_edit_map():
+    coordinator = TaskCoordinator()
+    coordinator.start_task(
+        task_id="voice_goal",
+        domain="navigation",
+        task_type="go_to_waypoint",
+        label="前往厨房",
+        priority=TaskPriority.USER_COMMAND,
+        resources=(TaskResource.MOTION,),
+        interruptible=True,
+    )
+    facade = AppGatewayDomainFacade(
+        None,
+        runtime_info=AppRuntimeInfo("robot_a", "机器人", "duole"),
+        task_coordinator=coordinator,
+    )
+    assert facade.query(request("claimMapSemanticsEdit")).data["accepted"] is False
+    assert coordinator.active_tasks()[0].task_id == "voice_goal"
+
+
+def test_unconfirmed_edit_can_be_cancelled_by_existing_app_emergency_stop():
+    coordinator = TaskCoordinator()
+    facade = AppGatewayDomainFacade(
+        None,
+        runtime_info=AppRuntimeInfo("robot_a", "机器人", "duole"),
+        task_coordinator=coordinator,
+    )
+    facade.query(request("claimMapSemanticsEdit"))
+    decision = coordinator.cancel_app_motion_tasks(operation_id="stop_" + "b" * 32)
+    assert decision.accepted and not coordinator.active_tasks()
